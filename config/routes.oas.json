{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Eventim POC API"
  },
  "paths": {
    "/v1/hello": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "operationId": "get-v1-hello",
        "summary": "Hello World (JWT protected)",
        "description": "Protected by the Keycloak multi-realm JWT policy. Pass a Bearer token issued by any trusted Keycloak realm.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "default",
            "module": "$import(./modules/hello-world)",
            "options": {}
          },
          "policies": {
            "inbound": ["keycloak-multi-realm-jwt-inbound"]
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  }
}
